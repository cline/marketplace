{
  "$schema": "../../../schemas/skill.schema.json",
  "id": "azure-devops",
  "type": "skill",
  "name": "Azure DevOps",
  "tagline": "Interact with Azure DevOps repositories, pull requests, and APIs using the AZURE_DEVOPS_TOKEN environment variable",
  "description": "Interact with Azure DevOps repositories, pull requests, and APIs using the AZURE_DEVOPS_TOKEN environment variable.",
  "author": {
    "name": "OpenHands",
    "url": "https://github.com/OpenHands"
  },
  "homepage": "https://github.com/OpenHands/extensions/tree/main/skills/azure-devops",
  "repo": "https://github.com/OpenHands/extensions",
  "tags": [
    "software"
  ],
  "license": "MIT",
  "verified": false,
  "featured": false,
  "install": {
    "args": [
      "OpenHands/extensions",
      "--skill",
      "azure-devops"
    ],
    "env": [
      {
        "name": "AZURE_DEVOPS_TOKEN",
        "required": true,
        "description": "Azure DevOps personal access token",
        "url": "https://learn.microsoft.com/en-us/azure/devops/organizations/accounts/use-personal-access-tokens-to-authenticate"
      }
    ]
  }
}
